{{- $items := slice -}}
{{- range (where site.RegularPages "Section" "posts").ByDate.Reverse -}}
  {{- $tags := slice -}}
  {{- range .GetTerms "tags" }}{{ $tags = $tags | append .LinkTitle }}{{ end -}}
  {{- $items = $items | append (dict
      "t" (.Title | htmlUnescape)
      "u" .RelPermalink
      "d" (.Date.Format "2006-01-02")
      "s" (.Params.summary | default "" | htmlUnescape)
      "g" $tags
      "c" (.Plain | htmlUnescape | replaceRE `\s+` " ")
  ) -}}
{{- end -}}
{{- $items | jsonify -}}
